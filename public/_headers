# Cloudflare Workers Static Assets Custom Headers
# Long-term immutable caching for static media, fonts, and assets

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

/hero-image.mp4
  Cache-Control: public, max-age=31536000, immutable

/hero-image-mobile.mp4
  Cache-Control: public, max-age=31536000, immutable

/hero-poster.webp
  Cache-Control: public, max-age=31536000, immutable

/hero-poster-mobile.webp
  Cache-Control: public, max-age=31536000, immutable

/hero-poster.png
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
